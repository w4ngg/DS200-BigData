# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
FRAME_TOPIC=camera.frames.raw
DETECTION_TOPIC=camera.detections.raw

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=people-counting
MINIO_SECURE=false

# MongoDB Atlas
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# Free tier MongoDB atlas
MONGODB_URI= mongodb+srv://23521294_db_user:root@cluster0.ttwnyca.mongodb.net
MONGODB_DATABASE=ds200_lab5_people_counting

# Model and video processing
MODEL_NAME=yolov8n.pt
MODEL_DEVICE=cpu
MODEL_IMAGE_SIZE=640
SAMPLE_FPS=1
RESIZE_WIDTH=640
SAVE_ANNOTATED_FRAMES=true
MAX_FRAMES=

# Service URLs inside Docker Compose
CAMERA_SERVER_URL=http://camera-server:8001
STORAGE_SERVER_URL=http://storage-server:8003

# Local service runtime
UPLOAD_DIR=/tmp/people-counting/uploads
SAMPLE_VIDEO_DIR=/app/data/sample_videos
LOG_LEVEL=INFO
